{
  "manifest_version": 3,
  "name": "GM Proxys Captcha Solver",
  "short_name": "GM Solver",
  "version": "1.4.4",
  "description": "Solver de captcha e proxy GM Proxys. Entre na conta, resolva captchas e navegue pela sua proxy.",
  "incognito": "spanning",
  "icons": {
    "192": "assets/icon-192.png",
    "512": "assets/icon-512.png"
  },
  "action": {
    "default_title": "GM PROXYS",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "192": "assets/icon-192.png",
      "512": "assets/icon-512.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus",
    "tabs",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://api.gmproxys.com/*",
    "https://gmproxys.com/*",
    "https://www.gmproxys.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "https://gmproxys.com/*",
        "https://www.gmproxys.com/*"
      ],
      "js": [
        "content/extension-auth.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
